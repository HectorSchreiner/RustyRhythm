{
    "name" : "RustyRythm",
    "version" : "1.0",
    "description" : "LogMessage Formatter for LogRythm",
    "permissions": [],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "RustyRythm.js", "run_wasm.js"
            ]
        }
    ],
    "web_accessible_resources": [{
        "resources": ["RustyRythm_bg.wasm"],
        "matches": ["<all_urls>"]
    }],
    "manifest_version": 3
}
