{
  "highlight_rules": [
    {
      "rule_type": "regex",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "style": "color:white;font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "style": "color:white;"
    },
    {
      "rule_type": "regex",
      "pattern": "\\b\\w*user\\w*=",
      "style": "color:white;font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "\\b\\w*description\\w*=",
      "style": "color:white;font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "\\b\\w+\\.(exe|txt|xml|jpg|xls|xlsx|doc|docx|dll)\\b",
      "style": "font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "\\b\\w+\\.(bat|ps1|ps)\\b",
      "style": "color:red;font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "(?i:pingcastle|rubeus|mimikatz|powersploit|empire|cobaltstrike|bloodhound|kerberoast|hashcat|responder|impacket|metasploit|wannacry|rubeus)",
      "style": "color:red;font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "([a-zA-Z]:\\\\|\\\\\\\\)[^\\\\/:*?\"<>|\\r\\n]+(\\\\[^\\\\/:*?\"<>|\\r\\n]+)*",
      "style": "font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "Name='[^']*'&gt;(\\w+)&lt;",
      "style": "font-weight:bold;"
    },
    {
      "rule_type": "exact",
      "pattern": "bytes 0",
      "style": "color:red;font-weight:bold;"
    },
    {
      "rule_type": "regex",
      "pattern": "(?i)(User|Domain): (\\w+)",
      "style": "color:white;"
    },
    {
      "rule_type": "regex",
      "pattern": "(?<=Name='TargetUserName'&gt;)(\\w+)(?=&lt;)",
      "style": "color:white;"
    },
    {
      "rule_type": "regex",
      "pattern": "(?i:USERKEY|USER)=([^\\s]+)",
      "style": "font-weight:bold;"
    },
    {
      "rule_type": "exact",
      "pattern": "duration=0",
      "style": "font-weight:bold;"
    }
  ],
  "deletion_rules": [
    {
      "rule_type": "regex",
      "pattern": "&lt;\\w&gt; = &lt;&gt;"
    },
    {
      "rule_type": "regex",
      "pattern": "\\b\\w+\\=\\s\\b"
    },
    {
      "rule_type": "exact",
      "pattern": "&lt;/Data&gt;&lt;Data&gt;"
    },
    {
      "rule_type": "exact",
      "pattern": "&lt;/Keywords&gt;&lt;Keywords&gt;"
    }    
  ],
  "change_rules": [
  ]
}
